{
  "name": "Formulário BCOMM",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "bcomm-contato",
        "options": {}
      },
      "id": "webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "webhookId": "bcomm-contato"
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "list",
          "value": "SUA_GOOGLE_SHEET_ID"
        },
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": "Contato"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Data": "={{ $json.data }}",
            "Nome": "={{ $json.nome }}",
            "Email": "={{ $json.email }}",
            "Telefone": "={{ $json.telefone }}",
            "Mensagem": "={{ $json.mensagem }}"
          }
        },
        "options": {}
      },
      "id": "google-sheets",
      "name": "Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [500, 300],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "SUA_CREDENTIAL_ID",
          "name": "Google Sheets OAuth2"
        }
      }
    },
    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "BCOMM - Recebemos sua mensagem",
        "emailType": "html",
        "message": "<div style=\"font-family: Inter, sans-serif; max-width: 600px; margin: 0 auto; padding: 32px; background: #000000; color: #f0f0f0;\">\n  <h1 style=\"font-size: 24px; color: #ffffff; margin-bottom: 16px;\">Olá, {{ $json.nome }}!</h1>\n  <p style=\"font-size: 16px; color: #a1a4a5; line-height: 1.6;\">Recebemos sua mensagem e em breve entraremos em contato.</p>\n  <div style=\"margin: 24px 0; padding: 16px; border: 1px solid #292d30; border-radius: 8px;\">\n    <p style=\"font-size: 14px; color: #6e6e7a; margin: 0 0 8px 0;\">Sua mensagem:</p>\n    <p style=\"font-size: 16px; color: #f0f0f0; margin: 0;\">{{ $json.mensagem }}</p>\n  </div>\n  <p style=\"font-size: 14px; color: #6e6e7a;\">Equipe BCOMM Comunicação Inteligente</p>\n  <p style=\"font-size: 12px; color: #464a4d; margin-top: 24px;\">contato@agent-bcomm.space</p>\n</div>",
        "options": {}
      },
      "id": "send-email",
      "name": "Enviar Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [750, 300],
      "credentials": {
        "smtp": {
          "id": "SUA_CREDENTIAL_ID",
          "name": "SMTP"
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Google Sheets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Sheets": {
      "main": [
        [
          {
            "node": "Enviar Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "BCOMM"
    }
  ]
}
